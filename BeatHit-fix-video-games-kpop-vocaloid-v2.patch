+def _match_trusted_kpop_artist(value: Any, trusted_aliases: dict[str, str]) -> str | None:
+    for alias in _kpop_artist_aliases(value):
+        if alias in trusted_aliases:
+            return trusted_aliases[alias]
+    return None
