+def _kpop_artist_aliases(value: Any) -> set[str]:
+    text = html.unescape(str(value or "")).strip()
+    if not text:
+        return set()
+    variants = {
+        norm(text),
+        _kpop_primary_artist_key(text),
+        norm(re.sub(r"[가-힣]+", " ", text)),
+        norm(re.sub(r"\([^)]*\)", " ", text)),
+    }
+    return {variant for variant in variants if variant}
+
