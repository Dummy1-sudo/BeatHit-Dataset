@@ -0,0 +1,98 @@
+name: expansion-high-coverage-build
+
+on:
+  workflow_dispatch:
+    inputs:
+      max_seconds:
+        description: "Maximum runtime for expansion builders"
+        required: false
+        default: "19000"
+        type: string
+  schedule:
+    - cron: '17 5 * * *'
+  push:
+    branches: [main]
+    paths:
+      - 'scripts/build_expansion_lists.py'
+      - 'data/seeds/beathit_video_games_master_list.txt'
+      - '.github/workflows/expansion-build.yml'
+
+permissions:
+  contents: write
+  actions: read
+
+concurrency:
+  group: beathit-expansion-build
+  cancel-in-progress: false
+
+jobs:
+  expansion:
+    runs-on: ubuntu-latest
+    timeout-minutes: 355
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 1
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+          cache: pip
+
+      - name: Install builder
+        run: |
+          python -m pip install --upgrade pip
+          pip install -e . -r requirements-full.txt
+
+      - name: Restore expansion checkpoints
+        uses: actions/cache/restore@v4
+        with:
+          path: .cache/beathit-expansion
+          key: beathit-expansion-v2-${{ runner.os }}-${{ github.run_id }}-${{ github.run_attempt }}
+          restore-keys: |
+            beathit-expansion-v2-${{ runner.os }}-
+            beathit-expansion-v1-${{ runner.os }}-
+
+      - name: Build language covers, Vocaloid covers, and per-game VGM
+        env:
+          PYTHONUNBUFFERED: '1'
+          BEATHIT_EXPANSION_MAX_SECONDS: ${{ github.event_name == 'workflow_dispatch' && inputs.max_seconds || '19000' }}
+          BEATHIT_COVER_MB_REQUESTS_PER_LANGUAGE: ${{ vars.BEATHIT_COVER_MB_REQUESTS_PER_LANGUAGE || '1200' }}
+          BEATHIT_VOCALOID_COVER_REQUESTS: ${{ vars.BEATHIT_VOCALOID_COVER_REQUESTS || '4000' }}
+          BEATHIT_PER_GAME_MAX_GAMES: ${{ vars.BEATHIT_PER_GAME_MAX_GAMES || '3162' }}
+        run: python scripts/build_expansion_lists.py
+
+      - name: Save expansion checkpoints
+        if: always()
+        uses: actions/cache/save@v4
+        with:
+          path: .cache/beathit-expansion
+          key: beathit-expansion-v2-${{ runner.os }}-${{ github.run_id }}-${{ github.run_attempt }}
+
+      - name: Validate generated CSV structure
+        run: python -m music_megalist validate
+
+      - name: Update manifest
+        run: python scripts/update_manifest.py
+
+      - name: Upload expansion outputs
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: beathit-expansion-output
+          path: |
+            STATUS.json
+            data/MANIFEST.json
+            data/language_covers/**/*.csv
+            data/vocaloid_covers/*.csv
+            data/video_games/per_game/*.csv
+
+      - name: Commit expansion outputs
+        run: |
+          git config user.name "BeatHit Dataset Builder"
+          git config user.email "actions@users.noreply.github.com"
+          git add -A -- STATUS.json data/MANIFEST.json data/language_covers data/vocaloid_covers data/video_games/per_game
+          if ! git diff --cached --quiet; then
+            git commit -m "Build resumable BeatHit expansion lists [skip full-build]"
+            git push origin HEAD:main
+          fi
