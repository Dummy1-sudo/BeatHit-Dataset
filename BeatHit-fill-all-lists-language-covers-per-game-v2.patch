@@ -0,0 +1,108 @@
+name: fill-remaining-core-lists
+
+on:
+  workflow_dispatch:
+  schedule:
+    - cron: '43 3 * * *'
+  push:
+    branches: [main]
+    paths:
+      - 'scripts/build_remaining_core.py'
+      - '.github/workflows/fill-remaining-core.yml'
+
+permissions:
+  contents: write
+  actions: read
+
+concurrency:
+  group: beathit-core-fill
+  cancel-in-progress: false
+
+jobs:
+  fill:
+    runs-on: ubuntu-latest
+    timeout-minutes: 355
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 1
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+          cache: pip
+
+      - name: Install builder
+        run: |
+          python -m pip install --upgrade pip
+          pip install -e . -r requirements-full.txt pytest
+
+      - name: Restore full-build caches
+        uses: actions/cache/restore@v4
+        with:
+          path: |
+            data/raw/full_build
+            .cache/full_build
+          key: beathit-core-fill-v2-${{ runner.os }}-${{ github.run_id }}-${{ github.run_attempt }}
+          restore-keys: |
+            beathit-core-fill-v2-${{ runner.os }}-
+            beathit-builder-checkpoints-v3-${{ runner.os }}-
+            beathit-sources-v5-${{ runner.os }}-
+
+      - name: Fill genuinely short core lists
+        env:
+          YOUTUBE_API_KEY: ${{ secrets.YOUTUBE_API_KEY }}
+          PYTHONUNBUFFERED: '1'
+          BEATHIT_RYD_FALLBACK: '1'
+          BEATHIT_RYD_WORKERS: '20'
+          BEATHIT_JIKAN_MAX_QUERIES: ${{ vars.BEATHIT_JIKAN_MAX_QUERIES || '5000' }}
+          BEATHIT_JIKAN_INDEX_PAGES: ${{ vars.BEATHIT_JIKAN_INDEX_PAGES || '400' }}
+          BEATHIT_JIKAN_MAX_SECONDS: ${{ vars.BEATHIT_JIKAN_MAX_SECONDS || '7200' }}
+          BEATHIT_JIKAN_FAILURE_BREAKER: '16'
+          BEATHIT_VOCADB_SCAN_LIMIT: ${{ vars.BEATHIT_VOCADB_SCAN_LIMIT || '500000' }}
+          BEATHIT_VOCALOID_VIEW_CACHE_DAYS: '30'
+          BEATHIT_LB_MAX_SECONDS: ${{ vars.BEATHIT_LB_MAX_SECONDS || '10800' }}
+          BEATHIT_LB_MAX_QUERIES: ${{ vars.BEATHIT_LB_MAX_QUERIES || '1200' }}
+          BEATHIT_COUNTRY_WORKERS: ${{ vars.BEATHIT_COUNTRY_WORKERS || '8' }}
+        run: python scripts/build_remaining_core.py
+
+      - name: Save full-build caches
+        if: always()
+        uses: actions/cache/save@v4
+        with:
+          path: |
+            data/raw/full_build
+            .cache/full_build
+          key: beathit-core-fill-v2-${{ runner.os }}-${{ github.run_id }}-${{ github.run_attempt }}
+
+      - name: Validate canonical CSV structure
+        run: python -m music_megalist validate
+
+      - name: Update manifest
+        run: python scripts/update_manifest.py
+
+      - name: Upload core outputs
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: beathit-core-fill-output
+          path: |
+            STATUS.json
+            data/MANIFEST.json
+            data/BUILD_REPORT.json
+            data/coverage_report.csv
+            data/anime/*.csv
+            data/vocaloid/*.csv*
+            data/video_games/video_game_music_10000.csv
+            data/children_childhood/*.csv
+            data/countries/*
+
+      - name: Commit core outputs
+        run: |
+          git config user.name "BeatHit Dataset Builder"
+          git config user.email "actions@users.noreply.github.com"
+          git add -A -- STATUS.json data/MANIFEST.json data/BUILD_REPORT.json data/coverage_report.csv data/anime data/vocaloid data/video_games/video_game_music_10000.csv data/children_childhood data/countries
+          if ! git diff --cached --quiet; then
+            git commit -m "Fill remaining BeatHit core lists [skip full-build]"
+            git push origin HEAD:main
+          fi
